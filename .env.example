# Optional local overrides. Keep OpenAI disabled unless cloud testing is explicitly approved.
# Never commit the real key or the resulting .env file.
OPENAI_API_KEY=
ARIS_ENABLE_OPENAI=false
ARIS_OPENAI_MODEL=gpt-5.6-terra
# Optional OpenAI Web Search. It reuses OPENAI_API_KEY but needs a separate cost opt-in.
# Each ARIS request requires exactly one Web Search tool call; the session cap bounds paid calls.
ARIS_ENABLE_WEB_SEARCH=false
ARIS_WEB_SEARCH_MODEL=gpt-5.6-terra
ARIS_WEB_SEARCH_SESSION_LIMIT=20
ARIS_WEB_SEARCH_CACHE_SECONDS=300
ARIS_TRANSCRIPTION_MODEL=gpt-transcribe
# Auto detects Vietnamese/English; pin vi or en only for a single-language installation.
ARIS_TRANSCRIPTION_LANGUAGE=auto
# Cloud speech has a separate cost opt-in; errors stay hidden without a Windows sound.
ARIS_ENABLE_CLOUD_TTS=false
# Optional YouTube playback; yt-dlp resolves one audio stream and does not save a media file.
ARIS_ENABLE_YOUTUBE_MUSIC=true
ARIS_TTS_MODEL=gpt-4o-mini-tts
ARIS_TTS_VOICE=marin
# Cinematic direction only; never request imitation of a real person or fictional character.
ARIS_TTS_INSTRUCTIONS=Speak in a calm, low-pitched feminine voice with a warm, futuristic tone at a moderately brisk pace. Be concise, precise, composed, and quietly authoritative. Use clean Vietnamese diction, restrained emotion, and avoid long pauses. Do not imitate any real person or fictional character.
ARIS_LANGUAGE=en
# Optional microphone index or partial device name. Laptop builds prefer Microphone Array.
ARIS_AUDIO_INPUT_DEVICE=
ARIS_AUTO_LISTEN=true
# Arduino UNO guard là opt-in; chỉ bật khi đã kiểm tra dây và nạp đúng firmware.
ARIS_ENABLE_HARDWARE=false
# Có thể đặt COM3 nếu auto-detect không tìm thấy đúng board.
ARIS_HARDWARE_PORT=
ARIS_GESTURE_MODE=spatial
# Measured smooth profile: a 60 FPS target outperforms an oversubscribed 120 FPS timer.
ARIS_RENDER_FPS=60
ARIS_VISION_FPS=24
ARIS_VISION_WIDTH=480
ARIS_VISION_HEIGHT=360
